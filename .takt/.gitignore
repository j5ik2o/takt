# Ignore everything by default
*

# This file itself
!.gitignore

# Project configuration
!config.yaml
!runtime.yaml

# Quality gate scripts (version-controlled; logs stay local)
!quality-gates/
!quality-gates/**
quality-gates/logs/

# Facets and pieces (version-controlled)
!workflows/
!workflows/**
!steps/
!steps/**
!facets/
!facets/personas/
!facets/personas/**
!facets/policies/
!facets/policies/**
!facets/knowledge/
!facets/knowledge/**
!facets/instructions/
!facets/instructions/**
!facets/output-contracts/
!facets/output-contracts/**

# Task finish hook (notify Orca when a TAKT task ends); logs stay local
!notify-orca.json
!scripts/
!scripts/**
__pycache__/
*.pyc
notify-orca.log
notify-orca.stderr
