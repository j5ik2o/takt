{
  "description": "Minimized counterexamples and regression inputs for range-merged sensitive text redaction.",
  "cases": [
    {
      "id": "quoted-credentials-url-password",
      "category": "quoted-assignment-url-tracking",
      "input": "CREDENTIALS=\"https://alice:pa55-word@host\"",
      "expectedSanitized": "CREDENTIALS=\"[REDACTED]\"",
      "followUpOutputs": [
        {
          "output": "echoed pa55-word",
          "expected": "echoed [REDACTED]"
        }
      ],
      "secrets": ["pa55-word"],
      "expectUnchanged": false
    },
    {
      "id": "repeated-sensitive-username-url-semicolon",
      "category": "linear-exclusion-advance",
      "input": "https://token:p@host;https://token:q@host2;TOKEN=left@RIGHT_SECRET",
      "expectedSanitized": "https://[REDACTED]@host;https://[REDACTED]@host2;TOKEN=[REDACTED]",
      "followUpOutputs": [
        {
          "output": "echoed p q left@RIGHT_SECRET",
          "expected": "echoed [REDACTED] [REDACTED] [REDACTED]"
        }
      ],
      "secrets": ["RIGHT_SECRET"],
      "expectUnchanged": false
    },
    {
      "id": "empty-user-port-url-in-json-array",
      "category": "url-authority-delimiter",
      "input": "[\"https://:443\",\"ops@example.test\"]",
      "expectedSanitized": "[\"https://:443\",\"ops@example.test\"]",
      "followUpOutputs": [],
      "secrets": [],
      "expectUnchanged": true
    },
    {
      "id": "quoted-token-url-password-parity",
      "category": "quoted-assignment-url-tracking",
      "input": "TOKEN=\"https://user:pa55-secret@host\"",
      "expectedSanitized": "TOKEN=\"[REDACTED]\"",
      "followUpOutputs": [
        {
          "output": "echoed pa55-secret",
          "expected": "echoed [REDACTED]"
        }
      ],
      "secrets": ["pa55-secret"],
      "expectUnchanged": false
    },
    {
      "id": "semicolon-url-and-bare-assignment-key-exclusion",
      "category": "semicolon-url-assignment-boundary",
      "input": "https://token:p@host;TOKEN=left@RIGHT_SECRET",
      "expectedSanitized": "https://[REDACTED]@host;TOKEN=[REDACTED]",
      "followUpOutputs": [
        {
          "output": "echoed p left@RIGHT_SECRET",
          "expected": "echoed [REDACTED] [REDACTED]"
        }
      ],
      "secrets": ["RIGHT_SECRET"],
      "expectUnchanged": false
    },
    {
      "id": "pbt-shrunk-bare-assignment-before-semicolon-json-array",
      "category": "pbt-counterexample-bare-assignment-delimiter",
      "input": "TOKEN=a_%a-%;[\"http://:80\",\"ops@example.test\"]",
      "expectedSanitized": "TOKEN=[REDACTED][\"http://:80\",\"ops@example.test\"]",
      "followUpOutputs": [
        {
          "output": "echoed a_%a-%",
          "expected": "echoed [REDACTED]"
        }
      ],
      "secrets": ["a_%a-%"],
      "expectUnchanged": false
    },
    {
      "id": "pbt-semicolon-chained-bare-assignments-and-urls",
      "category": "pbt-counterexample-semicolon-chain-tracking",
      "input": "https://u:p@host;TOKEN=left@RIGHT_SECRET;https://token:q@host2;TOKEN2=sec2",
      "expectedSanitized": "https://[REDACTED]@host;TOKEN=[REDACTED]",
      "followUpOutputs": [
        {
          "output": "echoed p q left@RIGHT_SECRET sec2",
          "expected": "echoed [REDACTED] [REDACTED] [REDACTED] [REDACTED]"
        }
      ],
      "secrets": ["RIGHT_SECRET", "sec2"],
      "expectUnchanged": false
    },
    {
      "id": "pbt-shrunk-leading-at-password-followed-by-later-email",
      "category": "pbt-counterexample-leading-at-password-tracking",
      "input": "http://a:@AaaaAa@host;ops@example.test",
      "expectedSanitized": "http://[REDACTED]@example.test",
      "followUpOutputs": [
        {
          "output": "echoed @AaaaAa",
          "expected": "echoed [REDACTED]"
        }
      ],
      "secrets": ["@AaaaAa"],
      "expectUnchanged": false
    }
  ]
}
